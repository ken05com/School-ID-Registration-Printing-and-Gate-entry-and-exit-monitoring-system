# --- App ---
APP_NAME="School ID System"
APP_BASE_URL=/
APP_ENV=local
APP_DEBUG=true

# --- Database ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=school_id_system
DB_USERNAME=root
DB_PASSWORD=